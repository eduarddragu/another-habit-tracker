<?xml version="1.0" encoding="utf-8"?>
<!-- Android backup (API 31+): the habit database (with its WAL files) goes to the user's Google account backup and moves
     with a device transfer. UI preferences stay on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
